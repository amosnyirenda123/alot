# ---- Gemini ----
GEMINI_API_KEY=your-key-here

# ---- App database (matches docker-compose defaults) ----
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
TEST_DATABASE_URL=

# ---- Langfuse (self-hosted via `--profile tracing`, or paste Langfuse Cloud keys) ----
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Compose-only settings for the Langfuse stack. Change these before exposing anything publicly.
# LANGFUSE_NEXTAUTH_SECRET=
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=     # openssl rand -hex 32
# LANGFUSE_PG_PASSWORD=
# LANGFUSE_CLICKHOUSE_PASSWORD=
# LANGFUSE_MINIO_PASSWORD=
# LANGFUSE_REDIS_PASSWORD=
# LANGFUSE_INIT_USER_EMAIL=admin@alot.dev
# LANGFUSE_INIT_USER_PASSWORD=changeme123

# ---- pgAdmin (`--profile tools`) ----
# PGADMIN_EMAIL=admin@alot.dev
# PGADMIN_PASSWORD=admin
